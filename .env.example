# Environment Configuration
# Copy ke .env dan sesuaikan dengan kebutuhan Anda

# ===== OLLAMA CONFIGURATION =====
# URL Ollama server
OLLAMA_HOST=http://localhost:11434

# Model yang digunakan
OLLAMA_MODEL=unsloth/gpt-oss-20b-GGUF:Q4_K_M

# ===== APPLICATION CONFIGURATION =====
# Share link publik untuk Gradio (true/false)
GRADIO_SHARE=false

# Port untuk Gradio interface
GRADIO_PORT=7860

# Server name (0.0.0.0 = accessible from network)
GRADIO_SERVER_NAME=0.0.0.0

# ===== MODEL PARAMETERS =====
# Temperature: 0.0 (fokus) - 1.0 (kreatif)
TEMPERATURE=0.7

# Top P: Diversity sampling (0.0 - 1.0)
TOP_P=0.9

# Maximum tokens dalam respons
MAX_TOKENS=2048

# ===== DEBUG =====
# Debug mode (true/false)
DEBUG=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
